module Main

import Fieldmouse
import System
import System.File

print_output : List String -> IO ()
print_output [] = pure ()
print_output (line :: rest) = do
  putStrLn line
  print_output rest

report_failure : String -> IO ()
report_failure message = do
  putStrLn ("fieldmouse: " ++ message)
  exitFailure

covering
run_source : String -> IO ()
run_source source = do
  result <- run source
  case result of
    Left problem => report_failure problem
    Right output => print_output output

covering
run_file : String -> IO ()
run_file path = do
  result <- readFile path
  case result of
    Left problem => report_failure ("cannot read " ++ path ++ ": " ++ show problem)
    Right source => run_source source

covering
main : IO ()
main = do
  arguments <- getArgs
  case arguments of
    _ :: "-e" :: source :: [] => run_source source
    _ :: path :: [] => run_file path
    _ => report_failure "usage: fieldmouse [-e source | file]"
