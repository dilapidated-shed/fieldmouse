module Fieldmouse

import public Fieldmouse.Language_types
import public Fieldmouse.Host_interface
import Fieldmouse.Tokenize_source
import Fieldmouse.Parse_source
import Fieldmouse.Primitive_values
import Fieldmouse.Runtime_storage
import Fieldmouse.Evaluate_program
import Fieldmouse.System_host
import Data.Maybe

-- Source programs may recurse or loop without a static termination proof.
%default covering

public export
run_command_with_host : Host → Text → IO (Either Text (List Text, Int))
run_command_with_host host source =
  case parse_program_source source of
    Left problem ⇒ pure (Left problem)
    Right program ⇒ do
      result ← execute_statement_sequence host create_runtime_with_console program
      pure (case result of
        Left problem ⇒ Left problem
        Right final_state ⇒ Right (collect_console_output_and_exit_status final_state))

public export
run_with_host : Host → Text → IO (Either Text (List Text))
run_with_host host source = do
  result ← run_command_with_host host source
  pure (case result of
    Left problem ⇒ Left problem
    Right (output, 0) ⇒ Right output
    Right (_, status) ⇒ Left ("script exited with status " ++ show status))

public export
run_command : List Text → Text → IO (Either Text (List Text, Int))
run_command arguments = run_command_with_host (execute_system_request arguments)

public export
run : Text → IO (Either Text (List Text))
run = run_with_host (execute_system_request [])

-- Retain the established public API while internal names state their purpose.
public export
lex : Text → Either Text (List token)
lex = tokenize_source

public export
parse : Text → Either Text (List statement)
parse = parse_program_source

public export
render : value → Text
render = display_value_for_console
