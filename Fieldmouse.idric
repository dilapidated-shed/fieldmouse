module Fieldmouse

import Data.String
import System.File

%default covering

public export
choice value one_of
  undefined_value
  null_value
  boolean_value Bool
  number_value Double
  string_value String

public export
choice token one_of
  word_token String
  number_token String
  text_token String
  symbol_token String

public export
choice unary_operator one_of
  unary_not
  unary_negate
  unary_positive

public export
choice binary_operator one_of
  binary_or
  binary_and
  binary_equal
  binary_not_equal
  binary_strict_equal
  binary_less
  binary_less_equal
  binary_greater
  binary_greater_equal
  binary_add
  binary_subtract
  binary_multiply
  binary_divide
  binary_remainder

public export
choice native_function one_of
  native_read_text
  native_write_text
  native_append_text
  native_file_exists

public export
choice expression one_of
  literal_expression value
  variable_expression String
  native_call_expression native_function (List expression)
  unary_expression unary_operator expression
  binary_expression binary_operator expression expression
  assignment_expression String expression

public export
choice statement one_of
  define_statement String expression
  expression_statement expression
  log_statement (List expression)
  block_statement (List statement)
  if_statement expression statement (Maybe statement)
  while_statement expression statement

Environment : Type
Environment = List (String, value)

Parser : Type -> Type
Parser result = List token -> Either String (result, List token)

public export
unary_operator_text : unary_operator -> String
unary_operator_text unary_not = "!"
unary_operator_text unary_negate = "-"
unary_operator_text unary_positive = "+"

public export
parse_unary_operator : String -> Maybe unary_operator
parse_unary_operator "!" = Just unary_not
parse_unary_operator "-" = Just unary_negate
parse_unary_operator "+" = Just unary_positive
parse_unary_operator _ = Nothing

public export
binary_operator_text : binary_operator -> String
binary_operator_text binary_or = "||"
binary_operator_text binary_and = "&&"
binary_operator_text binary_equal = "="
binary_operator_text binary_not_equal = "≠"
binary_operator_text binary_strict_equal = "≟"
binary_operator_text binary_less = "<"
binary_operator_text binary_less_equal = "<="
binary_operator_text binary_greater = ">"
binary_operator_text binary_greater_equal = ">="
binary_operator_text binary_add = "+"
binary_operator_text binary_subtract = "-"
binary_operator_text binary_multiply = "*"
binary_operator_text binary_divide = "/"
binary_operator_text binary_remainder = "%"

all_binary_operators : List binary_operator
all_binary_operators =
  [ binary_or
  , binary_and
  , binary_equal
  , binary_not_equal
  , binary_strict_equal
  , binary_less
  , binary_less_equal
  , binary_greater
  , binary_greater_equal
  , binary_add
  , binary_subtract
  , binary_multiply
  , binary_divide
  , binary_remainder
  ]

matching_binary_operator : String -> List binary_operator -> Maybe binary_operator
matching_binary_operator text [] = Nothing
matching_binary_operator text (operator :: rest) =
  if text == binary_operator_text operator
    then Just operator
    else matching_binary_operator text rest

public export
parse_binary_operator : String -> Maybe binary_operator
parse_binary_operator text = matching_binary_operator text all_binary_operators

public export
native_function_text : native_function -> String
native_function_text native_read_text = "readText"
native_function_text native_write_text = "writeText"
native_function_text native_append_text = "appendText"
native_function_text native_file_exists = "fileExists"

public export
parse_native_function : String -> Maybe native_function
parse_native_function "readText" = Just native_read_text
parse_native_function "writeText" = Just native_write_text
parse_native_function "appendText" = Just native_append_text
parse_native_function "fileExists" = Just native_file_exists
parse_native_function _ = Nothing

identifier_start : Char -> Bool
identifier_start character =
  isAlpha character || character == '_' || character == '$'

identifier_rest : Char -> Bool
identifier_rest character = identifier_start character || isDigit character

take_while : (Char -> Bool) -> List Char -> (List Char, List Char)
take_while predicate [] = ([], [])
take_while predicate input@(character :: rest) =
  if predicate character
    then let (taken, remaining) = take_while predicate rest
          in (character :: taken, remaining)
    else ([], input)

drop_line_comment : List Char -> List Char
drop_line_comment [] = []
drop_line_comment ('\n' :: rest) = rest
drop_line_comment (_ :: rest) = drop_line_comment rest

drop_block_comment : List Char -> Either String (List Char)
drop_block_comment [] = Left "unterminated block comment"
drop_block_comment ('*' :: '/' :: rest) = Right rest
drop_block_comment (_ :: rest) = drop_block_comment rest

read_string : Char -> List Char -> List Char -> Either String (String, List Char)
read_string quote collected [] = Left "unterminated string"
read_string quote collected (character :: rest) =
  if character == quote
    then Right (pack (reverse collected), rest)
    else case character of
      '\\' => case rest of
        [] => Left "unterminated string escape"
        'n' :: after => read_string quote ('\n' :: collected) after
        'r' :: after => read_string quote ('\r' :: collected) after
        't' :: after => read_string quote ('\t' :: collected) after
        '\\' :: after => read_string quote ('\\' :: collected) after
        '\'' :: after => read_string quote ('\'' :: collected) after
        '"' :: after => read_string quote ('"' :: collected) after
        escaped :: after => read_string quote (escaped :: collected) after
      _ => read_string quote (character :: collected) rest

read_number : Char -> List Char -> (String, List Char)
read_number first rest =
  let (integer_digits, after_integer) = take_while isDigit rest in
  case after_integer of
    '.' :: after_dot =>
      let (fraction_digits, remaining) = take_while isDigit after_dot in
      (pack ((first :: integer_digits) ++ ('.' :: fraction_digits)), remaining)
    _ => (pack (first :: integer_digits), after_integer)

public export
lex : String -> Either String (List token)
lex source = lex_characters (unpack source)
  where
    lex_characters : List Char -> Either String (List token)
    lex_characters [] = Right []
    lex_characters ('/' :: '/' :: rest) = lex_characters (drop_line_comment rest)
    lex_characters ('/' :: '*' :: rest) = do
      remaining <- drop_block_comment rest
      lex_characters remaining
    lex_characters ('=' :: '=' :: '=' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token "===" :: tokens)
    lex_characters ('!' :: '=' :: '=' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token "!==" :: tokens)
    lex_characters ('=' :: '=' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token "==" :: tokens)
    lex_characters ('!' :: '=' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token "!=" :: tokens)
    lex_characters ('<' :: '=' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token "<=" :: tokens)
    lex_characters ('>' :: '=' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token ">=" :: tokens)
    lex_characters ('&' :: '&' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token "&&" :: tokens)
    lex_characters ('|' :: '|' :: rest) = do
      tokens <- lex_characters rest
      Right (symbol_token "||" :: tokens)
    lex_characters (character :: rest) =
      if character == '\'' || character == '"'
        then do
          (text, remaining) <- read_string character [] rest
          tokens <- lex_characters remaining
          Right (text_token text :: tokens)
        else if isSpace character
          then lex_characters rest
          else if isDigit character
            then let (text, remaining) = read_number character rest in do
              tokens <- lex_characters remaining
              Right (number_token text :: tokens)
            else if identifier_start character
              then let (more, remaining) = take_while identifier_rest rest in do
                tokens <- lex_characters remaining
                Right (word_token (pack (character :: more)) :: tokens)
              else do
                tokens <- lex_characters rest
                Right (symbol_token (pack [character]) :: tokens)

expect_symbol : String -> List token -> Either String (List token)
expect_symbol expected (symbol_token actual :: rest) =
  if actual == expected
    then Right rest
    else Left ("expected '" ++ expected ++ "', found '" ++ actual ++ "'")
expect_symbol expected _ = Left ("expected '" ++ expected ++ "'")

drop_semicolon : List token -> List token
drop_semicolon (symbol_token ";" :: rest) = rest
drop_semicolon rest = rest

parse_left_associative : Parser expression -> List binary_operator -> Parser expression
parse_left_associative smaller operators input = do
  (first, rest) <- smaller input
  continue first rest
  where
    continue : expression -> List token -> Either String (expression, List token)
    continue left input@(symbol_token text :: rest) =
      case matching_binary_operator text operators of
        Just operator => do
          (right, after) <- smaller rest
          continue (binary_expression operator left right) after
        Nothing => Right (left, input)
    continue left rest = Right (left, rest)

mutual
  parse_expression : Parser expression
  parse_expression = parse_assignment

  parse_assignment : Parser expression
  parse_assignment input = do
    (left, rest) <- parse_or input
    case rest of
      symbol_token "←" :: after_arrow =>
        case left of
          variable_expression name => do
            (right, remaining) <- parse_assignment after_arrow
            Right (assignment_expression name right, remaining)
          _ => Left "left side of assignment must be a variable"
      symbol_token "→" :: word_token name :: remaining =>
        Right (assignment_expression name left, remaining)
      symbol_token "→" :: _ =>
        Left "right side of rightward assignment must be a variable"
      _ => Right (left, rest)

  parse_or : Parser expression
  parse_or = parse_left_associative parse_and [binary_or]

  parse_and : Parser expression
  parse_and = parse_left_associative parse_equality [binary_and]

  parse_equality : Parser expression
  parse_equality =
    parse_left_associative parse_comparison
      [binary_equal, binary_not_equal, binary_strict_equal]

  parse_comparison : Parser expression
  parse_comparison =
    parse_left_associative parse_addition
      [binary_less, binary_less_equal, binary_greater, binary_greater_equal]

  parse_addition : Parser expression
  parse_addition =
    parse_left_associative parse_multiplication [binary_add, binary_subtract]

  parse_multiplication : Parser expression
  parse_multiplication =
    parse_left_associative parse_unary
      [binary_multiply, binary_divide, binary_remainder]

  parse_unary : Parser expression
  parse_unary input@(symbol_token text :: rest) =
    case parse_unary_operator text of
      Just operator => do
        (body, remaining) <- parse_unary rest
        Right (unary_expression operator body, remaining)
      Nothing => parse_primary input
  parse_unary input = parse_primary input

  parse_primary : Parser expression
  parse_primary (number_token text :: rest) =
    case parseDouble text of
      Just parsed => Right (literal_expression (number_value parsed), rest)
      Nothing => Left ("invalid number '" ++ text ++ "'")
  parse_primary (text_token text :: rest) = Right (literal_expression (string_value text), rest)
  parse_primary (word_token "true" :: rest) = Right (literal_expression (boolean_value True), rest)
  parse_primary (word_token "Ø" :: rest) = Right (literal_expression (boolean_value False), rest)
  parse_primary (symbol_token "Ø" :: rest) = Right (literal_expression (boolean_value False), rest)
  parse_primary (word_token "null" :: rest) = Right (literal_expression null_value, rest)
  parse_primary (word_token "undefined" :: rest) = Right (literal_expression undefined_value, rest)
  parse_primary (word_token name :: symbol_token "(" :: rest) =
    case parse_native_function name of
      Just native => do
        (arguments, remaining) <- parse_native_arguments rest
        Right (native_call_expression native arguments, remaining)
      Nothing => Left ("unsupported native call '" ++ name ++ "'")
    where
      parse_native_arguments : List token -> Either String (List expression, List token)
      parse_native_arguments (symbol_token ")" :: remaining) = Right ([], remaining)
      parse_native_arguments input = do
        (first, after_first) <- parse_expression input
        continue [first] after_first
        where
          continue : List expression -> List token -> Either String (List expression, List token)
          continue collected (symbol_token "," :: after_comma) = do
            (next, after_next) <- parse_expression after_comma
            continue (next :: collected) after_next
          continue collected (symbol_token ")" :: remaining) = Right (reverse collected, remaining)
          continue _ _ = Left "expected ',' or ')' in native call"
  parse_primary (word_token name :: rest) = Right (variable_expression name, rest)
  parse_primary (symbol_token "(" :: rest) = do
    (inside, remaining) <- parse_expression rest
    after_close <- expect_symbol ")" remaining
    Right (inside, after_close)
  parse_primary [] = Left "expected expression, found end of input"
  parse_primary _ = Left "expected expression"

parse_log_arguments : List token -> Either String (List expression, List token)
parse_log_arguments (symbol_token ")" :: rest) = Right ([], rest)
parse_log_arguments input = do
  (first, rest) <- parse_expression input
  continue [first] rest
  where
    continue : List expression -> List token -> Either String (List expression, List token)
    continue collected (symbol_token "," :: rest) = do
      (next, remaining) <- parse_expression rest
      continue (next :: collected) remaining
    continue collected (symbol_token ")" :: rest) = Right (reverse collected, rest)
    continue _ _ = Left "expected ',' or ')' in console.log"

mutual
  parse_statement : Parser statement
  parse_statement (word_token keyword :: word_token name :: rest) =
    if elem keyword ["var", "let", "const"]
      then case rest of
        symbol_token "←" :: after_arrow => do
          (initial, remaining) <- parse_expression after_arrow
          Right (define_statement name initial, drop_semicolon remaining)
        _ => Right (define_statement name (literal_expression undefined_value), drop_semicolon rest)
      else parse_other_statement (word_token keyword :: word_token name :: rest)
  parse_statement input = parse_other_statement input

  parse_other_statement : Parser statement
  parse_other_statement (word_token "console" :: symbol_token "." :: word_token "log" :: symbol_token "(" :: rest) = do
    (arguments, remaining) <- parse_log_arguments rest
    Right (log_statement arguments, drop_semicolon remaining)
  parse_other_statement (word_token "if" :: symbol_token "(" :: rest) = do
    (condition, after_condition) <- parse_expression rest
    after_close <- expect_symbol ")" after_condition
    (yes_branch, after_yes) <- parse_statement after_close
    case after_yes of
      word_token "else" :: after_else => do
        (no_branch, remaining) <- parse_statement after_else
        Right (if_statement condition yes_branch (Just no_branch), remaining)
      _ => Right (if_statement condition yes_branch Nothing, after_yes)
  parse_other_statement (word_token "while" :: symbol_token "(" :: rest) = do
    (condition, after_condition) <- parse_expression rest
    after_close <- expect_symbol ")" after_condition
    (body, remaining) <- parse_statement after_close
    Right (while_statement condition body, remaining)
  parse_other_statement (symbol_token "{" :: rest) = do
    (body, remaining) <- parse_block rest
    Right (block_statement body, remaining)
  parse_other_statement input = do
    (body, remaining) <- parse_expression input
    Right (expression_statement body, drop_semicolon remaining)

  parse_block : List token -> Either String (List statement, List token)
  parse_block [] = Left "unterminated block"
  parse_block (symbol_token "}" :: rest) = Right ([], rest)
  parse_block input = do
    (first, rest) <- parse_statement input
    (later, remaining) <- parse_block rest
    Right (first :: later, remaining)

parse_program_tokens : List token -> Either String (List statement)
parse_program_tokens [] = Right []
parse_program_tokens input = do
  (first, rest) <- parse_statement input
  later <- parse_program_tokens rest
  Right (first :: later)

public export
parse : String -> Either String (List statement)
parse source = do
  tokens <- lex source
  parse_program_tokens tokens

lookup_variable : String -> Environment -> Either String value
lookup_variable name [] = Left ("unknown variable '" ++ name ++ "'")
lookup_variable name ((candidate, found) :: rest) =
  if name == candidate then Right found else lookup_variable name rest

set_variable : String -> value -> Environment -> Environment
set_variable name new_value [] = [(name, new_value)]
set_variable name new_value ((candidate, old_value) :: rest) =
  if name == candidate
    then (candidate, new_value) :: rest
    else (candidate, old_value) :: set_variable name new_value rest

define_variable : String -> value -> Environment -> Environment
define_variable name new_value environment = (name, new_value) :: environment

public export
render : value -> String
render undefined_value = "undefined"
render null_value = "null"
render (boolean_value True) = "true"
render (boolean_value False) = "false"
render (number_value number) = show number
render (string_value text) = text

truthy : value -> Bool
truthy undefined_value = False
truthy null_value = False
truthy (boolean_value truth) = truth
truthy (number_value number) = number /= 0.0
truthy (string_value text) = text /= ""

number_from_value : value -> Either String Double
number_from_value (number_value number) = Right number
number_from_value (boolean_value True) = Right 1.0
number_from_value (boolean_value False) = Right 0.0
number_from_value null_value = Right 0.0
number_from_value (string_value text) =
  case parseDouble text of
    Just number => Right number
    Nothing => Left ("cannot convert '" ++ text ++ "' to number")
number_from_value undefined_value = Left "cannot convert undefined to number"

same_value : value -> value -> Bool
same_value undefined_value undefined_value = True
same_value null_value null_value = True
same_value (boolean_value left) (boolean_value right) = left == right
same_value (number_value left) (number_value right) = left == right
same_value (string_value left) (string_value right) = left == right
same_value _ _ = False

coercive_equal : value -> value -> Bool
coercive_equal undefined_value null_value = True
coercive_equal null_value undefined_value = True
coercive_equal undefined_value right = same_value undefined_value right
coercive_equal left undefined_value = same_value left undefined_value
coercive_equal null_value right = same_value null_value right
coercive_equal left null_value = same_value left null_value
coercive_equal (number_value left) (string_value right) =
  case parseDouble right of
    Just right_number => left == right_number
    Nothing => False
coercive_equal (string_value left) (number_value right) =
  case parseDouble left of
    Just left_number => left_number == right
    Nothing => False
coercive_equal (boolean_value left) right =
  case number_from_value right of
    Right right_number => (if left then 1.0 else 0.0) == right_number
    Left _ => False
coercive_equal left (boolean_value right) =
  case number_from_value left of
    Right left_number => left_number == (if right then 1.0 else 0.0)
    Left _ => False
coercive_equal left right = same_value left right

calculate_numeric : binary_operator -> Double -> Double -> Either String value
calculate_numeric binary_add left right = Right (number_value (left + right))
calculate_numeric binary_subtract left right = Right (number_value (left - right))
calculate_numeric binary_multiply left right = Right (number_value (left * right))
calculate_numeric binary_divide left right = Right (number_value (left / right))
calculate_numeric binary_remainder left right = Left "remainder is not implemented yet"
calculate_numeric binary_less left right = Right (boolean_value (left < right))
calculate_numeric binary_less_equal left right = Right (boolean_value (left <= right))
calculate_numeric binary_greater left right = Right (boolean_value (left > right))
calculate_numeric binary_greater_equal left right = Right (boolean_value (left >= right))
calculate_numeric operator _ _ =
  Left
    ("unsupported numeric operator '" ++
     binary_operator_text operator ++ "'")

calculate_binary : binary_operator -> value -> value -> Either String value
calculate_binary binary_add (string_value left) right = Right (string_value (left ++ render right))
calculate_binary binary_add left (string_value right) = Right (string_value (render left ++ right))
calculate_binary binary_equal left right = Right (boolean_value (coercive_equal left right))
calculate_binary binary_not_equal left right = Right (boolean_value (not (coercive_equal left right)))
calculate_binary binary_strict_equal left right = Right (boolean_value (same_value left right))
calculate_binary operator left right = do
  left_number <- number_from_value left
  right_number <- number_from_value right
  calculate_numeric operator left_number right_number

file_problem : String -> String -> FileError -> String
file_problem operation path problem =
  operation ++ " '" ++ path ++ "': " ++ show problem

native_arity_problem : native_function -> Nat -> Nat -> String
native_arity_problem native expected actual =
  native_function_text native ++ ": expected " ++ show expected ++ " argument" ++
  (if expected == 1 then "" else "s") ++ ", found " ++ show actual

evaluate_native : Environment -> native_function -> List value -> IO (Either String (value, Environment))
evaluate_native environment native_read_text [string_value path] = do
  result <- readFile path
  case result of
    Left problem => pure (Left (file_problem "readText" path problem))
    Right contents => pure (Right (string_value contents, environment))
evaluate_native environment native_read_text [_] =
  pure (Left "readText: path must be text")
evaluate_native environment native_read_text arguments =
  pure (Left (native_arity_problem native_read_text 1 (length arguments)))
evaluate_native environment native_write_text [string_value path, string_value contents] = do
  result <- writeFile path contents
  case result of
    Left problem => pure (Left (file_problem "writeText" path problem))
    Right () => pure (Right (undefined_value, environment))
evaluate_native environment native_write_text [_, _] =
  pure (Left "writeText: path and contents must be text")
evaluate_native environment native_write_text arguments =
  pure (Left (native_arity_problem native_write_text 2 (length arguments)))
evaluate_native environment native_append_text [string_value path, string_value contents] = do
  result <- appendFile path contents
  case result of
    Left problem => pure (Left (file_problem "appendText" path problem))
    Right () => pure (Right (undefined_value, environment))
evaluate_native environment native_append_text [_, _] =
  pure (Left "appendText: path and contents must be text")
evaluate_native environment native_append_text arguments =
  pure (Left (native_arity_problem native_append_text 2 (length arguments)))
evaluate_native environment native_file_exists [string_value path] = do
  found <- exists path
  pure (Right (boolean_value found, environment))
evaluate_native environment native_file_exists [_] =
  pure (Left "fileExists: path must be text")
evaluate_native environment native_file_exists arguments =
  pure (Left (native_arity_problem native_file_exists 1 (length arguments)))

mutual
  evaluate : Environment -> expression -> IO (Either String (value, Environment))
  evaluate environment (literal_expression literal) = pure (Right (literal, environment))
  evaluate environment (variable_expression name) =
    case lookup_variable name environment of
      Left problem => pure (Left problem)
      Right found => pure (Right (found, environment))
  evaluate environment (native_call_expression name arguments) = do
    result <- evaluate_many environment arguments
    case result of
      Left problem => pure (Left problem)
      Right (values, after_arguments) => evaluate_native after_arguments name values
  evaluate environment (assignment_expression name body) = do
    result <- evaluate environment body
    case result of
      Left problem => pure (Left problem)
      Right (new_value, after_body) =>
        pure (Right (new_value, set_variable name new_value after_body))
  evaluate environment (unary_expression operator body) = do
    result <- evaluate environment body
    case result of
      Left problem => pure (Left problem)
      Right (body_value, after_body) =>
        case operator of
          unary_not => pure (Right (boolean_value (not (truthy body_value)), after_body))
          unary_negate => case number_from_value body_value of
            Left problem => pure (Left problem)
            Right number => pure (Right (number_value (-number), after_body))
          unary_positive => case number_from_value body_value of
            Left problem => pure (Left problem)
            Right number => pure (Right (number_value number, after_body))
  evaluate environment (binary_expression binary_and left right) = do
    result <- evaluate environment left
    case result of
      Left problem => pure (Left problem)
      Right (left_value, after_left) =>
        if truthy left_value
          then evaluate after_left right
          else pure (Right (left_value, after_left))
  evaluate environment (binary_expression binary_or left right) = do
    result <- evaluate environment left
    case result of
      Left problem => pure (Left problem)
      Right (left_value, after_left) =>
        if truthy left_value
          then pure (Right (left_value, after_left))
          else evaluate after_left right
  evaluate environment (binary_expression operator left right) = do
    left_result <- evaluate environment left
    case left_result of
      Left problem => pure (Left problem)
      Right (left_value, after_left) => do
        right_result <- evaluate after_left right
        case right_result of
          Left problem => pure (Left problem)
          Right (right_value, after_right) =>
            case calculate_binary operator left_value right_value of
              Left problem => pure (Left problem)
              Right answer => pure (Right (answer, after_right))

  evaluate_many : Environment -> List expression -> IO (Either String (List value, Environment))
  evaluate_many environment [] = pure (Right ([], environment))
  evaluate_many environment (first :: rest) = do
    first_result <- evaluate environment first
    case first_result of
      Left problem => pure (Left problem)
      Right (first_value, after_first) => do
        later_result <- evaluate_many after_first rest
        case later_result of
          Left problem => pure (Left problem)
          Right (later_values, after_later) =>
            pure (Right (first_value :: later_values, after_later))

execute_statement : Environment -> statement -> IO (Either String (Environment, List String))
execute_statement environment (define_statement name initial) = do
  result <- evaluate environment initial
  case result of
    Left problem => pure (Left problem)
    Right (initial_value, after_initial) =>
      pure (Right (define_variable name initial_value after_initial, []))
execute_statement environment (expression_statement body) = do
  result <- evaluate environment body
  case result of
    Left problem => pure (Left problem)
    Right (_, after_body) => pure (Right (after_body, []))
execute_statement environment (log_statement arguments) = do
  result <- evaluate_many environment arguments
  case result of
    Left problem => pure (Left problem)
    Right (values, after_arguments) =>
      pure (Right (after_arguments, [joinBy " " (map render values)]))
execute_statement environment (block_statement statements) = execute_block environment statements
  where
    execute_block : Environment -> List statement -> IO (Either String (Environment, List String))
    execute_block current [] = pure (Right (current, []))
    execute_block current (first :: rest) = do
      first_result <- execute_statement current first
      case first_result of
        Left problem => pure (Left problem)
        Right (after_first, first_output) => do
          later_result <- execute_block after_first rest
          case later_result of
            Left problem => pure (Left problem)
            Right (after_rest, later_output) =>
              pure (Right (after_rest, first_output ++ later_output))
execute_statement environment (if_statement condition yes_branch no_branch) = do
  result <- evaluate environment condition
  case result of
    Left problem => pure (Left problem)
    Right (condition_value, after_condition) =>
      if truthy condition_value
        then execute_statement after_condition yes_branch
        else case no_branch of
          Nothing => pure (Right (after_condition, []))
          Just branch => execute_statement after_condition branch
execute_statement environment loop@(while_statement condition body) = do
  result <- evaluate environment condition
  case result of
    Left problem => pure (Left problem)
    Right (condition_value, after_condition) =>
      if truthy condition_value
        then do
          body_result <- execute_statement after_condition body
          case body_result of
            Left problem => pure (Left problem)
            Right (after_body, body_output) => do
              loop_result <- execute_statement after_body loop
              case loop_result of
                Left problem => pure (Left problem)
                Right (after_loop, later_output) =>
                  pure (Right (after_loop, body_output ++ later_output))
        else pure (Right (after_condition, []))

execute_statements : Environment -> List statement -> IO (Either String (Environment, List String))
execute_statements environment [] = pure (Right (environment, []))
execute_statements environment (first :: rest) = do
  first_result <- execute_statement environment first
  case first_result of
    Left problem => pure (Left problem)
    Right (after_first, first_output) => do
      later_result <- execute_statements after_first rest
      case later_result of
        Left problem => pure (Left problem)
        Right (after_rest, later_output) =>
          pure (Right (after_rest, first_output ++ later_output))

public export
run : String -> IO (Either String (List String))
run source =
  case parse source of
    Left problem => pure (Left problem)
    Right program => do
      result <- execute_statements [] program
      case result of
        Left problem => pure (Left problem)
        Right (_, output) => pure (Right output)
