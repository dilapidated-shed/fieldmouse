module Fieldmouse

import public Fieldmouse.Language_types
import public Fieldmouse.Host_interface
import public Fieldmouse.Tokenize_source
import public Fieldmouse.Parse_source
import public Fieldmouse.Primitive_values
import Fieldmouse.Runtime_storage
import Fieldmouse.Evaluate_program
import Fieldmouse.System_host
import Data.Maybe

-- Source programs may recurse or loop without a static termination proof.
%default covering

public export
run_command_with_host : Host → Text → IO (Either Text (List Text, Int))
run_command_with_host host source =
  case parse source of
    Left problem ⇒ pure (Left problem)
    Right program ⇒ do
      let (console, with_console) = allocate_object [("log", native_value native_log)] initial_state
      result ← execute_statements host (bind_local "console" console with_console) program
      pure (case result of
        Left problem ⇒ Left problem
        Right after ⇒ Right (reverse after.output_reversed, fromMaybe 0 after.stopped))

public export
run_with_host : Host → Text → IO (Either Text (List Text))
run_with_host host source = do
  result ← run_command_with_host host source
  pure (case result of
    Left problem ⇒ Left problem
    Right (output, 0) ⇒ Right output
    Right (_, status) ⇒ Left ("script exited with status " ++ show status))

public export
run_command : List Text → Text → IO (Either Text (List Text, Int))
run_command arguments = run_command_with_host (file_host arguments)

public export
run : Text → IO (Either Text (List Text))
run = run_with_host (file_host [])
