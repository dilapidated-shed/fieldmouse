module Fieldmouse.Json_runtime_values

import Data.Text
import Data.List
import Data.Maybe
import Fieldmouse.Language_types
import Fieldmouse.Runtime_storage
import Fieldmouse.Json_syntax

-- Covering preserves the interpreter's deliberate recursion contract.
%default covering

mutual
  export
  create_runtime_value_from_json : json_data → Runtime → (value, Runtime)
  create_runtime_value_from_json json_null state = (null_value, state)
  create_runtime_value_from_json (json_boolean truth) state = (boolean_value truth, state)
  create_runtime_value_from_json (json_number number) state = (number_value number, state)
  create_runtime_value_from_json (json_text text) state = (string_value text, state)
  create_runtime_value_from_json (json_array members) state =
    let (values, after) = create_runtime_values_from_json_members members state in create_array_from_values values after
  create_runtime_value_from_json (json_object members) state =
    let (values, after) = create_runtime_members_from_json_properties members state
     in create_object_from_members values after

  create_runtime_values_from_json_members : List json_data → Runtime → (List value, Runtime)
  create_runtime_values_from_json_members [] state = ([], state)
  create_runtime_values_from_json_members (first :: rest) state =
    let (found, after_first) = create_runtime_value_from_json first state
        (later, after_later) = create_runtime_values_from_json_members rest after_first
     in (found :: later, after_later)

  create_runtime_members_from_json_properties : List (Text, json_data) → Runtime → (List (Text, value), Runtime)
  create_runtime_members_from_json_properties [] state = ([], state)
  create_runtime_members_from_json_properties ((key, first) :: rest) state =
    let (found, after_first) = create_runtime_value_from_json first state
        (later, after_later) = create_runtime_members_from_json_properties rest after_first
     in ((key, found) :: later, after_later)
mutual
  export
  serialize_runtime_value_as_json : Runtime → List Number → value → Either Text Text
  serialize_runtime_value_as_json state ancestors null_value = Right "null"
  serialize_runtime_value_as_json state ancestors (boolean_value truth) = Right (if truth then "true" else "false")
  serialize_runtime_value_as_json state ancestors (number_value number) =
    let text = show number in
    if isInfixOf "nan" (toLower text) || isInfixOf "inf" (toLower text)
      then Left "stringifyJson: nonfinite number"
      else Right text
  serialize_runtime_value_as_json state ancestors (string_value text) = Right (quote_json text)
  serialize_runtime_value_as_json state ancestors (array_value identity) = do
    if elem identity ancestors then Left "stringifyJson: cyclic array" else Right ()
    contents ← maybe (Left "invalid array identity") Right (find_entry_by_key identity state.stored_arrays_and_objects)
    members ← serialize_array_slots_as_json state (identity :: ancestors) contents 0 (fromMaybe 0 contents.array_length)
    Right ("[" ++ joinBy "," members ++ "]")
  serialize_runtime_value_as_json state ancestors (object_value identity) = do
    if elem identity ancestors then Left "stringifyJson: cyclic object" else Right ()
    contents ← maybe (Left "invalid object identity") Right (find_entry_by_key identity state.stored_arrays_and_objects)
    members ← traverse (serialize_object_member_as_json state (identity :: ancestors)) contents.properties
    Right ("{" ++ joinBy "," members ++ "}")
  serialize_runtime_value_as_json _ _ _ = Left "stringifyJson: undefined and functions are not JSON data"

  serialize_object_member_as_json : Runtime → List Number → (Text, value) → Either Text Text
  serialize_object_member_as_json state ancestors (key, found) = do
    text ← serialize_runtime_value_as_json state ancestors found
    Right (quote_json key ++ ":" ++ text)

  serialize_array_slots_as_json : Runtime → List Number → Aggregate → Number → Number → Either Text (List Text)
  serialize_array_slots_as_json state ancestors contents index size =
    if index >= size then Right [] else do
      text ← serialize_runtime_value_as_json state ancestors
        (fromMaybe null_value (find_entry_by_key (show index) contents.properties))
      later ← serialize_array_slots_as_json state ancestors contents (S index) size
      Right (text :: later)
