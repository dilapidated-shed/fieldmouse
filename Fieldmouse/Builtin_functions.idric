module Fieldmouse.Builtin_functions

import Data.Text
import Data.List
import Data.Maybe
import Data.List1
import Fieldmouse.Language_types
import Fieldmouse.Primitive_values
import Fieldmouse.Runtime_storage
import Fieldmouse.Host_interface
import Fieldmouse.Json_syntax
import Fieldmouse.Json_runtime_values
import Fieldmouse.Posix_paths

-- Covering preserves the interpreter's deliberate recursion contract.
%default covering

describe_builtin_argument_count_error : native_function → Number → Number → Text
describe_builtin_argument_count_error native expected actual =
  native_function_text native ++ ": expected " ++ show expected ++ " argument" ++
  (if expected ≟ 1 then "" else "s") ++ ", found " ++ show actual

prepare_host_request_from_arguments : Runtime → native_function → List value → Either Text host_request
prepare_host_request_from_arguments state native_read_text [string_value path] = Right (read_text_request path)
prepare_host_request_from_arguments state native_write_text [string_value path, string_value contents] = Right (write_text_request path contents)
prepare_host_request_from_arguments state native_append_text [string_value path, string_value contents] = Right (append_text_request path contents)
prepare_host_request_from_arguments state native_file_exists [string_value path] = Right (file_exists_request path)
prepare_host_request_from_arguments state native_arguments [] = Right arguments_request
prepare_host_request_from_arguments state native_environment [string_value name] =
  if name ≟ "" || any (\c ⇒ c ≟ '=' || c ≟ '\0') (unpack name)
     then Left "environment: invalid variable name"
     else Right (environment_request name)
prepare_host_request_from_arguments state native_list_directory [string_value path] = Right (list_directory_request path)
prepare_host_request_from_arguments state native_create_directory [string_value path] = Right (create_directory_request path)
prepare_host_request_from_arguments state native_exit [number_value status] =
  if status >= 0 && status <= 255 && status ≟ cast (the Int (cast status))
     then Right (exit_request (cast status))
     else Left "exit: status must be an integer from 0 to 255"
prepare_host_request_from_arguments state native_subprocess [string_value program, arguments] = do
  values ← read_dense_text_array state arguments
  if program ≟ "" || any (\text ⇒ elem '\0' (unpack text)) (program :: values)
    then Left "subprocess: empty program or NUL in argument"
    else Right (subprocess_request program values)
prepare_host_request_from_arguments state native arguments =
  let expected : Number = case native of
        native_arguments ⇒ 0
        native_write_text ⇒ 2
        native_append_text ⇒ 2
        native_subprocess ⇒ 2
        _ ⇒ 1
   in if length arguments /= expected
        then Left (describe_builtin_argument_count_error native expected (length arguments))
        else Left (native_function_text native ++ ": invalid argument types")
import_host_response_into_runtime : Runtime → host_request → host_response → Either Text (value, Runtime)
import_host_response_into_runtime state (read_text_request _) (text_response text) = Right (string_value text, state)
import_host_response_into_runtime state (write_text_request _ _) done_response = Right (undefined_value, state)
import_host_response_into_runtime state (append_text_request _ _) done_response = Right (undefined_value, state)
import_host_response_into_runtime state (file_exists_request _) (boolean_response truth) = Right (boolean_value truth, state)
import_host_response_into_runtime state arguments_request (texts_response texts) = Right (create_array_from_values (map string_value texts) state)
import_host_response_into_runtime state (environment_request _) (optional_text_response text) =
  Right (maybe undefined_value string_value text, state)
import_host_response_into_runtime state (list_directory_request _) (texts_response texts) =
  Right (create_array_from_values (map string_value texts) state)
import_host_response_into_runtime state (create_directory_request _) done_response = Right (undefined_value, state)
import_host_response_into_runtime state (exit_request status) done_response = Right (undefined_value, { program_exit_status := Just status } state)
import_host_response_into_runtime state (subprocess_request _ _) (process_response status text) =
  Right (create_object_from_members [("status", number_value (cast status)), ("stdout", string_value text)] state)
import_host_response_into_runtime state request _ =
  Left ("host returned wrong response for '" ++ host_request_name request ++ "'")
perform_checked_host_request : Host → Runtime → host_request → IO (Either Text (value, Runtime))
perform_checked_host_request host state request =
  case check_file_request_text_has_no_nul request of
    Left problem ⇒ pure (Left problem)
    Right () ⇒ do
      response ← host request
      pure (case response of
        Left problem ⇒ Left problem
        Right response_value ⇒ import_host_response_into_runtime state request response_value)

execute_builtin_in_running_program : Host → Runtime → native_function → List value → IO (Either Text (value, Runtime))
execute_builtin_in_running_program host state native_log arguments =
  pure (Right (undefined_value, { console_lines_reversed := joinBy " " (map display_value_for_console arguments) :: state.console_lines_reversed } state))
execute_builtin_in_running_program host state native_parse_json [string_value text] =
  pure (case parse_json_text text of
    Left problem ⇒ Left ("parseJson: malformed JSON: " ++ problem)
    Right data_value ⇒ Right (create_runtime_value_from_json data_value state))
execute_builtin_in_running_program host state native_stringify_json [found] =
  pure (do text ← serialize_runtime_value_as_json state [] found
           Right (string_value text, state))
execute_builtin_in_running_program host state native_join_path arguments =
  pure (do parts ← require_text_values arguments
           Right (string_value (case parts of
             [] ⇒ "."
             first :: rest ⇒ join_path_parts first rest), state))
execute_builtin_in_running_program host state native_normalize_path [string_value text] =
  pure (Right (string_value (normalize_path text), state))
execute_builtin_in_running_program host state native_basename [string_value text] =
  pure (Right (string_value (path_basename text), state))
execute_builtin_in_running_program host state native_dirname [string_value text] =
  pure (Right (string_value (path_dirname text), state))
execute_builtin_in_running_program host state native arguments =
  case prepare_host_request_from_arguments state native arguments of
    Left problem ⇒ pure (Left problem)
    Right request ⇒ perform_checked_host_request host state request

export
call_builtin_function : Host → Runtime → native_function → List value → IO (Either Text (value, Runtime))
call_builtin_function host state native arguments =
  if isJust state.program_exit_status then pure (Right (undefined_value, state))
    else execute_builtin_in_running_program host state native arguments
