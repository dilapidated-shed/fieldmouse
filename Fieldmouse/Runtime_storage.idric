module Fieldmouse.Runtime_storage

import Data.String
import Data.List
import Data.Maybe
import Data.List1
import Fieldmouse.Language_types

-- Covering preserves the interpreter's deliberate recursion contract.
%default covering

Environment : Type
Environment = List (String, value)
lookup_variable : String -> Environment -> Either String value
lookup_variable name [] = Left ("unknown variable '" ++ name ++ "'")
lookup_variable name ((candidate, found) :: rest) =
  if name == candidate then Right found else lookup_variable name rest

set_variable : String -> value -> Environment -> Environment
set_variable name new_value [] = [(name, new_value)]
set_variable name new_value ((candidate, old_value) :: rest) =
  if name == candidate
    then (candidate, new_value) :: rest
    else (candidate, old_value) :: set_variable name new_value rest

define_variable : String -> value -> Environment -> Environment
define_variable name new_value environment = (name, new_value) :: environment
-- Identities belong to interpreter storage; no host handles enter this model.
public export
record Aggregate where
  constructor AggregateContents
  array_length : Maybe Number
  properties : List (Text, value)

public export
record Closure where
  constructor CapturedFunction
  parameter_names : List Text
  body : List statement
  bindings : List (Text, Number)

public export
record Runtime where
  constructor ScriptState
  bindings : List (Text, Number)
  cells : List (Number, value)
  aggregates : List (Number, Aggregate)
  functions : List (Number, Closure)
  next_identity : Number
  -- Prepend while evaluating; restore chronological order only at the run boundary.
  output_reversed : List Text
  returned : Maybe value
  stopped : Maybe Int
  call_depth : Number

export
initial_state : Runtime
initial_state = ScriptState [] [] [] [] 0 [] Nothing Nothing 0

export
lookup_entry : Eq key => key → List (key, item) → Maybe item
lookup_entry name [] = Nothing
lookup_entry name ((candidate, found) :: rest) =
  if name ≟ candidate then Just found else lookup_entry name rest

export
put_entry : Eq key => key → item → List (key, item) → List (key, item)
put_entry name found [] = [(name, found)]
put_entry name found ((candidate, previous) :: rest) =
  if name ≟ candidate then (name, found) :: rest
    else (candidate, previous) :: put_entry name found rest

export
bind_local : Text → value → Runtime → Runtime
bind_local name found state =
  let identity = state.next_identity in
  { bindings := (name, identity) :: state.bindings,
    cells := (identity, found) :: state.cells,
    next_identity := S identity } state

export
read_binding : Text → Runtime → Either Text value
read_binding name state = do
  identity ← maybe (Left ("unknown variable '" ++ name ++ "'")) Right
                   (lookup_entry name state.bindings)
  maybe (Left "invalid binding identity") Right (lookup_entry identity state.cells)

export
write_binding : Text → value → Runtime → Runtime
write_binding name found state =
  case lookup_entry name state.bindings of
    Nothing ⇒ bind_local name found state
    Just identity ⇒ { cells := put_entry identity found state.cells } state

export
store_aggregate : Aggregate → Runtime → (value, Runtime)
store_aggregate contents state =
  let identity = state.next_identity
      result = case contents.array_length of
        Nothing ⇒ object_value identity
        Just _ ⇒ array_value identity
   in (result, { aggregates := (identity, contents) :: state.aggregates,
                 next_identity := S identity } state)

export
allocate_object : List (Text, value) → Runtime → (value, Runtime)
allocate_object members =
  -- Repeated keys keep their first position and their last value.
  store_aggregate (AggregateContents Nothing
    (foldl (\kept, pair ⇒ put_entry (fst pair) (snd pair) kept) [] members))

indexed_members : Number → List value → List (Text, value)
indexed_members index [] = []
indexed_members index (first :: rest) = (show index, first) :: indexed_members (S index) rest

export
allocate_array : List value → Runtime → (value, Runtime)
allocate_array members =
  -- These canonical sequential keys are unique by construction.
  store_aggregate (AggregateContents (Just (length members)) (indexed_members 0 members))

export
key_from_value : value → Either Text Text
key_from_value (string_value text) = Right text
key_from_value (number_value number) =
  if number >= 0 && number == cast (the Integer (cast number))
     then Right (show (the Integer (cast number)))
     else Left "property number must be a nonnegative integer"
key_from_value _ = Left "property key must be text or a nonnegative integer"

export
array_index : Text → Either Text Number
array_index text =
  if text /= "" && all isDigit (unpack text)
     then let index : Number = cast text in
          if show index ≟ text then Right index else Left "array index must be canonical"
     else Left "array index must be a nonnegative integer"

export
read_property : Runtime → value → Text → Either Text value
read_property state (array_value identity) key = do
  contents ← maybe (Left "invalid array identity") Right (lookup_entry identity state.aggregates)
  if key ≟ "length"
     then Right (number_value (cast (fromMaybe 0 contents.array_length)))
     else do
       index ← array_index key
       Right (fromMaybe undefined_value (lookup_entry key contents.properties))
read_property state (object_value identity) key = do
  contents ← maybe (Left "invalid object identity") Right (lookup_entry identity state.aggregates)
  Right (fromMaybe undefined_value (lookup_entry key contents.properties))
read_property state (string_value text) "length" = Right (number_value (cast (length text)))
read_property _ _ _ = Left "property access requires an array, object, or text length"

export
write_property : Runtime → value → Text → value → Either Text Runtime
write_property state (array_value identity) key found = do
  contents ← maybe (Left "invalid array identity") Right (lookup_entry identity state.aggregates)
  index ← array_index key
  let size = max (S index) (fromMaybe 0 contents.array_length)
  let changed = AggregateContents (Just size) (put_entry key found contents.properties)
  Right ({ aggregates := put_entry identity changed state.aggregates } state)
write_property state (object_value identity) key found = do
  contents ← maybe (Left "invalid object identity") Right (lookup_entry identity state.aggregates)
  let changed : Aggregate = { properties := put_entry key found contents.properties } contents
  Right ({ aggregates := put_entry identity changed state.aggregates } state)
write_property _ _ _ _ = Left "property assignment requires an array or object"
export
text_values : List value → Either Text (List Text)
text_values [] = Right []
text_values (string_value text :: rest) = do
  later ← text_values rest
  Right (text :: later)
text_values _ = Left "expected an array of text"

export
array_text_values : Runtime → value → Either Text (List Text)
array_text_values state (array_value identity) = do
  contents ← maybe (Left "invalid array identity") Right (lookup_entry identity state.aggregates)
  gather contents 0 (fromMaybe 0 contents.array_length)
  where
    gather : Aggregate → Number → Number → Either Text (List Text)
    gather contents index size =
      if index >= size then Right [] else
      case lookup_entry (show index) contents.properties of
        Just (string_value text) ⇒ do
          later ← gather contents (S index) size
          Right (text :: later)
        _ ⇒ Left "expected a dense array of text"
array_text_values _ _ = Left "expected an array of text"
export
halted : Runtime → Bool
halted state = isJust state.returned || isJust state.stopped
